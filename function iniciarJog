<!DOCTYPE html>
<html lang="pt-BR">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width,
initial-scale=1.0,
maximum-scale=1.0,
user-scalable=no">

<meta name="theme-color" content="#050814">

<link rel="manifest" href="manifest.json">

<title>Last Second</title>

<style>

/* =========================
   BASE
========================= */

*{
box-sizing:border-box;
user-select:none;
-webkit-user-select:none;
-webkit-tap-highlight-color:transparent;
}

html,body{
margin:0;
width:100%;
height:100%;
overflow:hidden;
}

body{

background:
radial-gradient(
circle at 50% 20%,
#172a52 0%,
#0a1024 38%,
#03050d 100%
);

color:white;

font-family:
Arial,
Helvetica,
sans-serif;

text-align:center;

touch-action:none;

position:relative;
}


/* =========================
   FUNDO
========================= */

body::before{

content:"";

position:fixed;

width:500px;
height:500px;

top:-250px;
left:50%;

transform:translateX(-50%);

background:
radial-gradient(
circle,
rgba(0,180,255,.12),
transparent 65%
);

filter:blur(20px);

pointer-events:none;

}

body::after{

content:"";

position:fixed;

width:350px;
height:350px;

bottom:-200px;
right:-150px;

background:
radial-gradient(
circle,
rgba(115,70,255,.10),
transparent 65%
);

filter:blur(30px);

pointer-events:none;

}


/* =========================
   MENUS
========================= */

#menu,
#gameOver{

width:min(400px,94vw);

height:min(500px,82vh);

min-height:450px;

margin:20px auto;

position:relative;

overflow:hidden;

background:
linear-gradient(
145deg,
rgba(20,31,59,.82),
rgba(5,9,22,.90)
);

border:1px solid rgba(255,255,255,.10);

border-radius:28px;

box-shadow:

0 25px 80px rgba(0,0,0,.55),

0 0 60px rgba(0,140,255,.12),

inset 0 1px 0 rgba(255,255,255,.08);

backdrop-filter:blur(18px);
-webkit-backdrop-filter:blur(18px);

display:flex;

flex-direction:column;

justify-content:center;

align-items:center;

}


/* brilho decorativo */

#menu::before,
#gameOver::before{

content:"";

position:absolute;

width:220px;
height:220px;

top:-130px;
right:-100px;

border-radius:50%;

background:
radial-gradient(
circle,
rgba(0,200,255,.15),
transparent 70%
);

filter:blur(10px);

pointer-events:none;

}

#menu::after,
#gameOver::after{

content:"";

position:absolute;

width:180px;
height:180px;

bottom:-120px;
left:-90px;

border-radius:50%;

background:
radial-gradient(
circle,
rgba(100,70,255,.12),
transparent 70%
);

filter:blur(10px);

pointer-events:none;

}


/* =========================
   TITULO
========================= */

#titulo{

font-size:clamp(38px,12vw,52px);

font-weight:900;

letter-spacing:6px;

margin-bottom:46px;

position:relative;

background:
linear-gradient(
135deg,
#ffffff 0%,
#8fe9ff 45%,
#6f8cff 100%
);

-webkit-background-clip:text;
background-clip:text;

color:transparent;

text-shadow:
0 0 25px rgba(0,200,255,.25);

animation:
tituloFlutuar 3s ease-in-out infinite;

}

@keyframes tituloFlutuar{

0%,100%{
transform:translateY(0);
}

50%{
transform:translateY(-5px);
}

}


/* pequeno brilho abaixo do título */

#titulo::after{

content:"";

position:absolute;

left:50%;

bottom:-16px;

transform:translateX(-50%);

width:80px;
height:2px;

background:
linear-gradient(
90deg,
transparent,
#4ddcff,
transparent
);

box-shadow:
0 0 12px #00cfff;

}


/* =========================
   SUBTITULO
========================= */

#subtitulo{

margin-top:-25px;

margin-bottom:38px;

color:#8f9bb8;

font-size:12px;

font-weight:bold;

letter-spacing:3px;

}


/* =========================
   BOTÕES
========================= */

button{

font-family:inherit;

padding:15px 40px;

font-size:18px;

font-weight:bold;

color:white;

border:none;

border-radius:50px;

cursor:pointer;

touch-action:none;

transition:

transform .18s ease,

box-shadow .18s ease,

filter .18s ease;

}


/* botão jogar */

#jogar,
#tentarNovamente{

position:relative;

background:
linear-gradient(
135deg,
#00b8ff,
#5367ff
);

box-shadow:

0 8px 25px rgba(0,130,255,.30),

inset 0 1px 0 rgba(255,255,255,.35);

letter-spacing:1px;

}

#jogar:hover,
#tentarNovamente:hover{

transform:
translateY(-3px)
scale(1.03);

box-shadow:

0 12px 35px rgba(0,160,255,.42),

inset 0 1px 0 rgba(255,255,255,.4);

filter:brightness(1.08);

}

#jogar:active,
#tentarNovamente:active{

transform:
scale(.96);

}


/* =========================
   RECORD
========================= */

#melhor{

margin-top:28px;

font-size:12px;

font-weight:bold;

letter-spacing:2px;

color:#7f8ba5;

text-transform:uppercase;

}

#recordeMenu{

color:#ffffff;

font-size:18px;

margin-left:5px;

text-shadow:
0 0 12px rgba(0,200,255,.5);

}


/* =========================
   JOGO
========================= */

#telaJogo{

display:none;

width:100%;

height:100%;

}


/* =========================
   HUD
========================= */

#barraSuperior{

width:min(400px,94vw);

margin:10px auto;

display:flex;

justify-content:space-between;

align-items:center;

font-weight:bold;

}


#pontuacao,
#vidas{

font-size:14px;

letter-spacing:1px;

}


#pontuacao{

padding:9px 15px;

border-radius:30px;

background:
rgba(12,22,44,.72);

border:1px solid rgba(255,255,255,.08);

box-shadow:
0 5px 20px rgba(0,0,0,.25);

color:#dbeaff;

}


#vidas{

padding:8px 12px;

border-radius:30px;

background:
rgba(12,22,44,.72);

border:1px solid rgba(255,255,255,.08);

box-shadow:
0 5px 20px rgba(0,0,0,.25);

letter-spacing:3px;

}


/* =========================
   ÁREA DO JOGO
========================= */

#jogo{

width:min(400px,94vw);

height:min(500px,calc(100vh - 130px));

max-height:500px;

position:relative;

overflow:hidden;

margin:auto;

border:1px solid rgba(255,255,255,.12);

border-radius:24px;

background:

radial-gradient(
ellipse at 50% 0%,
#193968 0%,
#0b1730 30%,
#050a19 70%,
#02040b 100%
);

box-shadow:

0 25px 60px rgba(0,0,0,.5),

0 0 50px rgba(0,130,255,.14),

inset 0 0 40px rgba(0,0,0,.35);

}


/* brilho superior do campo */

#jogo::before{

content:"";

position:absolute;

top:0;
left:0;

width:100%;
height:130px;

background:
linear-gradient(
180deg,
rgba(70,180,255,.08),
transparent
);

pointer-events:none;

z-index:1;

}


/* =========================
   PERSONAGEM
========================= */

#personagem{

width:40px;
height:40px;

position:absolute;

bottom:10px;

left:calc(50% - 20px);

z-index:10;

border-radius:50%;

background:

radial-gradient(
circle at 35% 30%,
#ffffff 0%,
#b8f5ff 25%,
#36cfff 55%,
#3970ff 100%
);

box-shadow:

0 0 12px #4ddfff,

0 0 25px rgba(0,190,255,.75),

0 0 45px rgba(0,120,255,.35);

animation:
pulsar .8s ease-in-out infinite alternate;

}


/* brilho interno */

#personagem::after{

content:"";

position:absolute;

width:10px;
height:10px;

top:7px;
left:9px;

border-radius:50%;

background:white;

filter:blur(2px);

opacity:.9;

}


@keyframes pulsar{

from{
transform:scale(.94);
}

to{
transform:scale(1.04);
}

}


/* =========================
   ESCUDO
========================= */

#personagem.escudo{

box-shadow:

0 0 10px #00d9ff,

0 0 25px #00ffff,

0 0 50px #00aaff,

0 0 75px rgba(0,255,255,.4);

border:2px solid #8fffff;

}


/* =========================
   OBSTÁCULOS
========================= */

.obstaculo{

width:40px;
height:40px;

position:absolute;

z-index:5;

border-radius:50%;

background:

radial-gradient(
circle at 30% 25%,
#fff0b0 0%,
#ff9d54 12%,
#ff4e5f 38%,
#8d2356 72%,
#351133 100%
);

box-shadow:

0 0 12px rgba(255,70,100,.65),

0 0 25px rgba(255,30,90,.18);

}


/* =========================
   MOEDAS
========================= */

.moeda{

width:24px;
height:24px;

position:absolute;

z-index:6;

border-radius:50%;

background:

radial-gradient(
circle at 35% 30%,
#fffbd0 0%,
#ffe66d 20%,
#ffc400 55%,
#a86500 100%
);

box-shadow:

0 0 10px #ffd000,

0 0 22px rgba(255,200,0,.3);

animation:
girar .7s linear infinite;

}


@keyframes girar{

0%{
transform:rotateY(0deg);
}

50%{
transform:rotateY(90deg);
}

100%{
transform:rotateY(180deg);
}

}


/* =========================
   POWERUPS
========================= */

.powerup{

width:32px;
height:32px;

position:absolute;

z-index:7;

border-radius:50%;

display:flex;

align-items:center;

justify-content:center;

font-size:17px;

font-weight:bold;

border:1px solid rgba(255,255,255,.3);

}


.powerup-escudo{

background:
radial-gradient(
circle,
#5ce8ff,
#008dff
);

box-shadow:

0 0 15px #00ffff,

0 0 30px rgba(0,200,255,.4);

}


.powerup-velocidade{

background:
radial-gradient(
circle,
#fff56b,
#ffb800
);

color:#111;

box-shadow:

0 0 15px #ffea00,

0 0 30px rgba(255,220,0,.35);

}


/* =========================
   ESTRELAS
========================= */

.estrela{

position:absolute;

width:2px;
height:2px;

background:white;

border-radius:50%;

box-shadow:
0 0 6px white;

opacity:.7;

}


/* =========================
   PAUSA
========================= */

#pausado{

display:none;

position:absolute;

z-index:100;

width:100%;
height:100%;

top:0;
left:0;

background:
rgba(2,6,18,.72);

backdrop-filter:blur(8px);
-webkit-backdrop-filter:blur(8px);

align-items:center;

justify-content:center;

flex-direction:column;

}


#pausado h1{

font-size:42px;

letter-spacing:5px;

margin:0 0 12px;

text-shadow:
0 0 25px rgba(0,190,255,.5);

}


#pausado p{

color:#8f9bb8;

font-size:12px;

letter-spacing:1px;

}


/* =========================
   GAME OVER
========================= */

#gameOver h1{

font-size:42px;

letter-spacing:5px;

margin:0 0 15px;

background:
linear-gradient(
135deg,
#ffffff,
#8bdfff
);

-webkit-background-clip:text;
background-clip:text;

color:transparent;

}


#gameOver h2{

font-size:28px;

margin:8px 0;

font-weight:bold;

}


#gameOver h3{

color:#7886a5;

font-size:14px;

letter-spacing:2px;

margin-bottom:32px;

}


#novoRecorde{

display:none;

color:#ffd000;

font-weight:bold;

letter-spacing:2px;

margin-bottom:20px;

animation:
piscar .7s infinite alternate;

text-shadow:
0 0 15px rgba(255,210,0,.5);

}


@keyframes piscar{

from{
opacity:.5;
transform:scale(.98);
}

to{
opacity:1;
transform:scale(1.02);
}

}


/* =========================
   CONTROLES MOBILE
========================= */

#controles{

width:min(400px,94vw);

margin:10px auto;

display:flex;

justify-content:space-between;

gap:14px;

}


.controle{

width:50%;

height:58px;

padding:0;

background:
rgba(15,27,53,.75);

border:1px solid rgba(255,255,255,.12);

border-radius:18px;

font-size:25px;

color:#ccefff;

box-shadow:

0 8px 25px rgba(0,0,0,.35),

inset 0 1px 0 rgba(255,255,255,.08);

}


.controle:active{

transform:
scale(.94);

background:
rgba(25,60,100,.9);

box-shadow:
0 3px 12px rgba(0,150,255,.25);

}


@media (min-width:601px){

#controles{

display:none;

}

}


@media (max-height:650px){

#jogo{

height:calc(100vh - 115px);

}

#personagem{

bottom:6px;

}

#controles{

margin:5px auto;

}

.controle{

height:48px;

}

}


/* =========================
   MOBILE
========================= */

@media (max-width:420px){

#menu,
#gameOver{

border-radius:24px;

}

#titulo{

letter-spacing:4px;

}

#subtitulo{

font-size:10px;

letter-spacing:2px;

}

}


/* =========================
   ANIMAÇÃO DE ENTRADA
========================= */

#menu,
#gameOver{

animation:
entrada .55s ease both;

}


@keyframes entrada{

from{

opacity:0;

transform:
translateY(15px)
scale(.97);

}

to{

opacity:1;

transform:
translateY(0)
scale(1);

}

}

</style>

</head>

<body>


<!-- =========================
     MENU
========================= -->

<div id="menu">

<div id="titulo">
LAST SECOND
</div>

<div id="subtitulo">
SOBREVIVA O MÁXIMO QUE PUDER
</div>

<button id="jogar">
▶ &nbsp; JOGAR
</button>

<div id="melhor">

RECORDE:
<span id="recordeMenu">0</span>

</div>

</div>


<!-- =========================
     JOGO
========================= -->

<div id="telaJogo">

<div id="barraSuperior">

<div id="pontuacao">
SCORE: 0
</div>

<div id="vidas">
❤️❤️❤️
</div>

</div>


<div id="jogo">

<div id="personagem"></div>


<div id="pausado">

<h1>
PAUSADO
</h1>

<p>
Pressione P para continuar
</p>

</div>

</div>


<div id="controles">

<button class="controle" id="esquerda">
◀
</button>

<button class="controle" id="direita">
▶
</button>

</div>

</div>


<!-- =========================
     GAME OVER
========================= -->

<div id="gameOver">

<h1>
FIM DE JOGO
</h1>

<h2>

SCORE:
<span id="pontuacaoFinal">
0
</span>

</h2>

<h3>

RECORDE:
<span id="recordeFinal">
0
</span>

</h3>

<div id="novoRecorde">
🏆 &nbsp; NOVO RECORDE!
</div>

<button id="tentarNovamente">
↻ &nbsp; JOGAR NOVAMENTE
</button>

</div>


<script>

/* =========================
   ELEMENTOS
========================= */

const menu =
document.getElementById("menu");

const telaJogo =
document.getElementById("telaJogo");

const gameOver =
document.getElementById("gameOver");

const jogar =
document.getElementById("jogar");

const tentarNovamente =
document.getElementById("tentarNovamente");

const jogo =
document.getElementById("jogo");

const personagem =
document.getElementById("personagem");

const pontuacao =
document.getElementById("pontuacao");

const vidasElemento =
document.getElementById("vidas");

const pausadoElemento =
document.getElementById("pausado");


/* =========================
   VARIÁVEIS
========================= */

let recorde =
Number(localStorage.getItem("recorde")) || 0;

let recordeAnterior =
recorde;

let posicao;
let pontos;
let vidas;
let velocidade;
let jogoRodando = false;
let pausado = false;

let esquerdaPressionada =
false;

let direitaPressionada =
false;

let escudoAtivo =
false;

let velocidadeExtra =
0;

let loop;

let audioContext =
null;


/* =========================
   MÚSICA
========================= */

let musicaAtiva =
false;

let musicaIntervalo =
null;

let musicaNota =
0;


/* =========================
   RECORDE
========================= */

document
.getElementById("recordeMenu")
.innerText =
recorde;


/* =========================
   BOTÕES
========================= */

jogar.addEventListener(
"click",
iniciarJogo
);

tentarNovamente.addEventListener(
"click",
iniciarJogo
);


/* =========================
   INICIAR JOGO
========================= */

function iniciarJogo(){

menu.style.display =
"none";

gameOver.style.display =
"none";

telaJogo.style.display =
"block";

iniciarPartida();

}


/* =========================
   PARTIDA
========================= */

function iniciarPartida(){

document
.querySelectorAll(
".obstaculo,.moeda,.powerup,.estrela"
)
.forEach(
elemento =>
elemento.remove()
);


posicao =
(jogo.clientWidth-40)/2;

pontos =
0;

vidas =
3;

velocidade =
4;

jogoRodando =
true;

pausado =
false;

iniciarMusica();

esquerdaPressionada =
false;

direitaPressionada =
false;

escudoAtivo =
false;

velocidadeExtra =
0;

recordeAnterior =
recorde;


personagem.style.left =
posicao+"px";

personagem.classList.remove(
"escudo"
);

personagem.style.opacity =
"1";


pontuacao.innerText =
"SCORE: 0";

atualizarVidas();

pausadoElemento.style.display =
"none";


criarEstrelas();


let obstaculos = [];

for(
let i=0;
i<4;
i++
){

obstaculos.push(
criarObstaculo(
-100-i*150
)
);

}


let moedas = [];

for(
let i=0;
i<2;
i++
){

moedas.push(
criarMoeda(
-300-i*250
)
);

}


let powerups = [];


/* =========================
   TECLADO
========================= */

document.onkeydown =
function(evento){

if(
evento.key ===
"ArrowLeft"
){

esquerdaPressionada =
true;

evento.preventDefault();

}

if(
evento.key ===
"ArrowRight"
){

direitaPressionada =
true;

evento.preventDefault();

}

if(
evento.key.toLowerCase() ===
"p"
){

alternarPausa();

}

};


document.onkeyup =
function(evento){

if(
evento.key ===
"ArrowLeft"
){

esquerdaPressionada =
false;

}

if(
evento.key ===
"ArrowRight"
){

direitaPressionada =
false;

}

};


/* =========================
   LOOP
========================= */

loop =
setInterval(
function(){

if(
!jogoRodando ||
pausado
){

return;

}


const limiteX =
jogo.clientWidth-40;

const velocidadeJogador =
6+velocidadeExtra;


if(
esquerdaPressionada
){

posicao -=
velocidadeJogador;

}


if(
direitaPressionada
){

posicao +=
velocidadeJogador;

}


if(
posicao < 0
){

posicao =
0;

}


if(
posicao > limiteX
){

posicao =
limiteX;

}


personagem.style.left =
posicao+"px";


moverEstrelas();


/* =========================
   OBSTÁCULOS
========================= */

obstaculos.forEach(
function(obstaculo){

obstaculo.top +=
obstaculo.velocidade;

obstaculo.elemento.style.top =
obstaculo.top+"px";


if(
obstaculo.top >
jogo.clientHeight
){

obstaculo.top =
-50;

obstaculo.elemento.style.left =
Math.random() *
limiteX+"px";

obstaculo.velocidade =
velocidade +
Math.random()*2;

pontos++;

atualizarPontuacao();

verificarDificuldade();

}


if(
colidiu(
personagem,
obstaculo.elemento
)
){

if(
!escudoAtivo
){

perderVida();

obstaculo.top =
-60;

}else{

obstaculo.top =
-50;

obstaculo.elemento.style.left =
Math.random() *
limiteX+"px";

tocarSom(
150,
"sawtooth",
.1
);

}

}

});


/* =========================
   MOEDAS
========================= */

moedas.forEach(
function(moeda){

moeda.top +=
velocidade*.8;

moeda.elemento.style.top =
moeda.top+"px";


if(
moeda.top >
jogo.clientHeight
){

moeda.top =
-30;

moeda.elemento.style.left =
Math.random() *
(jogo.clientWidth-24)+"px";

}


if(
colidiu(
personagem,
moeda.elemento
)
){

pontos +=
5;

atualizarPontuacao();

moeda.top =
-100;

moeda.elemento.style.top =
"-100px";

tocarSom(
800,
"sine",
.12
);

}

});


/* =========================
   POWERUPS
========================= */

powerups.forEach(
function(powerup){

powerup.top +=
velocidade;

powerup.elemento.style.top =
powerup.top+"px";


if(
powerup.top >
jogo.clientHeight
){

powerup.top =
-100;

powerup.elemento.style.top =
"-100px";

}


if(
colidiu(
personagem,
powerup.elemento
)
){

ativarPowerUp(
powerup.tipo
);

powerup.top =
-100;

powerup.elemento.style.top =
"-100px";

}

});


if(
Math.random() < .002 &&
powerups.length < 2
){

powerups.push(
criarPowerUp()
);

}

},
30
);

}


/* =========================
   ESTRELAS
========================= */

function criarEstrelas(){

for(
let i=0;
i<45;
i++
){

const estrela =
document.createElement("div");

estrela.classList.add(
"estrela"
);

const tamanho =
