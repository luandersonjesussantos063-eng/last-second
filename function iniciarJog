/* =========================
   ÁUDIO
========================= */

function tocarSom(
frequencia,
tipo,
duracao
){

try{

const AudioContext =
window.AudioContext ||
window.webkitAudioContext;


if(
!audioContext
){

audioContext =
new AudioContext();

}


if(
audioContext.state ===
"suspended"
){

audioContext.resume();

}


const oscilador =
audioContext.createOscillator();

const ganho =
audioContext.createGain();


oscilador.type =
tipo;

oscilador.frequency.value =
frequencia;


ganho.gain.setValueAtTime(
.08,
audioContext.currentTime
);


ganho.gain.exponentialRampToValueAtTime(
.001,
audioContext.currentTime +
duracao
);


oscilador.connect(
ganho
);

ganho.connect(
audioContext.destination
);


oscilador.start();

oscilador.stop(
audioContext.currentTime +
duracao
);

}catch(erro){

console.log(
"Áudio não disponível"
);

}

}


/* =========================
   INICIAR MÚSICA
========================= */

function iniciarMusica(){

try{

if(
!audioContext
){

const AudioContext =
window.AudioContext ||
window.webkitAudioContext;

audioContext =
new AudioContext();

}


if(
audioContext.state ===
"suspended"
){

audioContext.resume();

}


if(
musicaAtiva
){

return;

}


musicaAtiva =
true;

musicaNota =
0;


musicaIntervalo =
setInterval(
function(){

if(
!musicaAtiva ||
pausado ||
!jogoRodando
){

return;

}


/*
   A música fica um pouco mais rápida
   conforme a velocidade aumenta.
*/

const intervalo =
Math.max(
130,
250 -
(velocidade-4)*12
);


clearInterval(
musicaIntervalo
);

musicaIntervalo =
setInterval(
tocarNotaMusica,
intervalo
);

},
250
);


/* começa imediatamente */

tocarNotaMusica();

}catch(erro){

console.log(
"Música não disponível"
);

}

}


/* =========================
   NOTA DA MÚSICA
========================= */

function tocarNotaMusica(){

if(
!musicaAtiva ||
pausado ||
!jogoRodando
){

return;

}


try{

const notas =
[
220,
277,
330,
440,
330,
277
];


const frequencia =
notas[
musicaNota %
notas.length
];


const oscilador =
audioContext.createOscillator();

const ganho =
audioContext.createGain();


oscilador.type =
"triangle";

oscilador.frequency.value =
frequencia;


ganho.gain.setValueAtTime(
0.025,
audioContext.currentTime
);


ganho.gain.exponentialRampToValueAtTime(
0.001,
audioContext.currentTime +
0.18
);


oscilador.connect(
ganho
);

ganho.connect(
audioContext.destination
);


oscilador.start();

oscilador.stop(
audioContext.currentTime +
0.18
);


musicaNota++;


}catch(erro){

console.log(
"Música não disponível"
);

}

}


/* =========================
   CONTROLES
========================= */

const botaoEsquerda =
document.getElementById(
"esquerda"
);

const botaoDireita =
document.getElementById(
"direita"
);


function configurarControle(
botao,
pressionar,
soltar
){

botao.addEventListener(
"pointerdown",
function(evento){

evento.preventDefault();

pressionar();

try{

botao.setPointerCapture(
evento.pointerId
);

}catch(e){}

}
);


botao.addEventListener(
"pointerup",
function(evento){

evento.preventDefault();

soltar();

}
);


botao.addEventListener(
"pointercancel",
soltar
);

botao.addEventListener(
"lostpointercapture",
soltar
);

}


configurarControle(

botaoEsquerda,

function(){

esquerdaPressionada =
true;

},

function(){

esquerdaPressionada =
false;

}

);


configurarControle(

botaoDireita,

function(){

direitaPressionada =
true;

},

function(){

direitaPressionada =
false;

}

);


window.addEventListener(
"blur",
function(){

esquerdaPressionada =
false;

direitaPressionada =
false;

}
);


