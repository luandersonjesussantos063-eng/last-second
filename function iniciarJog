/* =========================
   COLISÃO
========================= */

function colidiu(
elementoA,
elementoB
){

const a =
elementoA.getBoundingClientRect();

const b =
elementoB.getBoundingClientRect();

return(

a.left < b.right &&
a.right > b.left &&
a.top < b.bottom &&
a.bottom > b.top

);

}


